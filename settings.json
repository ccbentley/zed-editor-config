{
  "show_edit_predictions": false,
  "disable_ai": false,
  "cli_default_open_behavior": "existing_window",
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false
  },
  "icon_theme": "Base Charmed Icons",
  "language_models": {
    "lmstudio": {
      "api_url": "http://127.0.0.1:1234/api/v0"
    }
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "project_panel": {
    "file_icons": true,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Everforest Dark Hard (blur)",
  },
}
